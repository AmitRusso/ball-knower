		// 	"database_id": "00000000-0000-0000-0000-000000000000",
		// 	"migrations_dir": "db/migrations"
		// },
		{
			"binding": "ball_knower",
			"database_name": "ball-knower",
			"database_id": "ad86e2d3-52f4-498e-be98-f8ac4a879578"
		}
	],
	"kv_namespaces": [
		{
			"binding": "HOLES",
			"id": "b0a08664197b48e8a9edb99490af4250"
		}
	]
}
