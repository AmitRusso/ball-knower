		{
			"binding": "ball_knower",
			"database_name": "ball-knower",
			"database_id": "ad86e2d3-52f4-498e-be98-f8ac4a879578",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "HOLES",
