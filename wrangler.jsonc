{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ball-knower",
	"compatibility_date": "2026-10-25",
	"compatibility_flags": ["nodejs_als"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
